{% extends 'base.html.twig' %}

{% block title %}No data yet — Strava Data{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body p-5 text-center">
            <h1 class="h3 mb-3">No activities synced yet</h1>
            <p class="text-body-secondary mb-4">
                Configure your Strava API credentials and refresh token in <code>.env.local</code>,
                then run the initial sync:
            </p>
            <pre class="text-start bg-body-tertiary p-3 rounded d-inline-block mb-0"><code>docker compose exec app php bin/console app:strava:full-sync -v</code></pre>
        </div>
    </div>
{% endblock %}
