{% extends 'base.html.twig' %}

{% block title %}Map — Strava Data{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Activity map</h1>
    <p class="text-body-secondary">Generate a PNG with all activities whose start point falls within a radius of a chosen location.</p>

    <form method="get" action="{{ path('app_map_render') }}" target="_blank" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Center latitude</label>
            <input name="center_lat" type="number" step="0.000001" required value="{{ defaults.center_lat }}" class="form-control">
        </div>
        <div class="col-md-4">
            <label class="form-label">Center longitude</label>
            <input name="center_lng" type="number" step="0.000001" required value="{{ defaults.center_lng }}" class="form-control">
        </div>
        <div class="col-md-4">
            <label class="form-label">Radius (km)</label>
            <input name="radius_km" type="number" step="0.1" min="0.1" required value="{{ defaults.radius_km }}" class="form-control">
        </div>

        <div class="col-md-3">
            <label class="form-label">Background</label>
            <select name="background" class="form-select" id="background-select">
                <option value="tiles" {{ defaults.background == 'tiles' ? 'selected' }}>OSM tiles</option>
                <option value="blank" {{ defaults.background == 'blank' ? 'selected' }}>Plain colour (no tiles)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Background colour</label>
            <input name="background_color" type="color" value="{{ defaults.background_color }}" class="form-control form-control-color">
            <div class="form-text small">Used only when background is "Plain colour".</div>
        </div>
        <div class="col-md-3">
            <label class="form-label">Trace colour</label>
            <input name="trace_color" type="color" value="{{ defaults.trace_color }}" class="form-control form-control-color">
        </div>
        <div class="col-md-3">
            <label class="form-label">Trace opacity</label>
            <input name="trace_opacity" type="number" step="0.05" min="0" max="1" value="{{ defaults.trace_opacity }}" class="form-control">
        </div>

        <div class="col-md-3">
            <label class="form-label">Trace width (px)</label>
            <input name="trace_width" type="number" step="1" min="1" max="20" value="{{ defaults.trace_width }}" class="form-control">
        </div>
        <div class="col-md-3">
            <label class="form-label">Image width (px)</label>
            <input name="width" type="number" step="64" min="256" max="4096" value="{{ defaults.width }}" class="form-control">
        </div>
        <div class="col-md-3">
            <label class="form-label">Image height (px)</label>
            <input name="height" type="number" step="64" min="256" max="4096" value="{{ defaults.height }}" class="form-control">
        </div>
        <div class="col-md-3">
            <label class="form-label">Sport types (optional)</label>
            <select name="sport_types[]" multiple class="form-select" size="3">
                {% for s in sport_types %}
                    <option value="{{ s }}" {{ s in defaults.sport_types ? 'selected' }}>{{ s }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">From</label>
            <input name="from" type="date" value="{{ defaults.from }}" class="form-control">
        </div>
        <div class="col-md-6">
            <label class="form-label">To</label>
            <input name="to" type="date" value="{{ defaults.to }}" class="form-control">
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Render map</button>
            <span class="text-body-secondary small ms-2">Opens the PNG in a new tab.</span>
        </div>
    </form>
{% endblock %}
