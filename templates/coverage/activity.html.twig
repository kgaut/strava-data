{% extends 'base.html.twig' %}

{% block title %}{{ activity.name }} — Coverage{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<style>
    #activity-map { height: calc(100vh - 240px); min-height: 480px; border-radius: 8px; }
</style>
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <div>
            <h1 class="h3 mb-1">{{ activity.name }}</h1>
            <div class="text-body-secondary small">
                {{ activity.startDateLocal|date('Y-m-d H:i') }} · {{ activity.sportType }} ·
                {{ (activity.distance / 1000)|number_format(1, '.', ' ') }} km
            </div>
        </div>
        <div class="text-end">
            <div class="text-body-secondary small">New ground</div>
            <div class="fs-3 text-warning">+{{ (new_meters / 1000)|number_format(1, '.', ' ') }} km</div>
        </div>
    </div>

    <div id="activity-map"></div>
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    const map = L.map('activity-map', {preferCanvas: true});
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors', maxZoom: 19,
    }).addTo(map);

    fetch('{{ path('app_coverage_activity_geojson', {id: activity.id}) }}', {headers: {'Accept': 'application/json'}})
        .then(r => r.json())
        .then(data => {
            const layer = L.geoJSON(data, {
                style: f => {
                    if (f.properties.kind === 'trace') {
                        return {color: '#000', weight: 1, opacity: 0.4, dashArray: '4 4'};
                    }
                    if (f.properties.first_here) {
                        return {color: '#fc4c02', weight: 4, opacity: 0.95};
                    }
                    if (f.properties.visited) {
                        return {color: '#888', weight: 2, opacity: 0.6};
                    }
                    return {color: '#ccc', weight: 1.5, opacity: 0.4};
                },
            }).addTo(map);
            map.fitBounds(layer.getBounds(), {padding: [20, 20]});
        });
</script>
{% endblock %}
